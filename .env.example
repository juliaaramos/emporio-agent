# --- Provedor do modelo ---
# groq (padrão) | gemini | ollama | openai. Todos usam API compatível com a da OpenAI.
LLM_PROVIDER=groq

# Chaves (só a do provedor escolhido é necessária). Groq e Gemini têm plano gratuito sem cartão:
#   Gemini: https://aistudio.google.com/apikey
#   Groq:   https://console.groq.com/keys
#   Ollama: local, sem chave (https://ollama.com, depois: ollama pull qwen2.5:3b)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=

# Trocar o modelo de um provedor (opcional):
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OLLAMA_MODEL=qwen2.5:7b
# Teto de tokens de resposta (opcional). No plano gratuito da Groq, alguns modelos
# (ex.: qwen/qwen3.8-27b) recusam pedidos sem teto: use GROQ_MAX_TOKENS=900.
# GROQ_MAX_TOKENS=900

# Provedor livre (sobrescreve o LLM_PROVIDER): qualquer endpoint compatível com a OpenAI
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_API_KEY=

LLM_TEMPERATURE=0

# --- Relógio da loja ---
# Os dados terminam em 22/03/2026. Usamos 25/03/2026 como "hoje" para que
# prazos de entrega, devolução e garantia façam sentido. Deixe vazio para usar a data real.
REFERENCE_DATE=2026-03-25
# Hora fixa (HH:MM, fuso America/Campo_Grande). Vazio = hora atual do relógio.
REFERENCE_TIME=10:30
